# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL_STAGE1=claude-haiku-4-5
MODEL_STAGE2=claude-haiku-4-5
MODEL_STAGE3=claude-sonnet-5

# Обязательные настройки экономии: см. CLAUDE.md
STAGE1_BATCH_SIZE=50
STAGE2_BATCH_SIZE=20
USE_BATCH_API=true
USE_PROMPT_CACHING=true

# Потолок расходов за прогон, USD. Пайплайн останавливается при превышении.
MAX_RUN_COST_USD=25

# --- Telegram ---
# Авторизованный отдельный тестовый аккаунт с законным доступом к группам
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=buyerscout_poc

# --- Хранилище ---
DB_PATH=./data/buyerscout.db
RETENTION_DAYS=30
